{
  "id": "dev.solvit.workspace",
  "name": "工作区与 Shell",
  "description": "当前对话的工作区文件和多个 Shell 命令会话；不包含交互式 PTY、Root 或 Linux 发行版。",
  "version": "1.4.0",
  "apiVersion": 18,
  "permissions": [
    "workspace",
    "shell"
  ],
  "dependencies": [],
  "tools": [
    {
      "name": "info",
      "description": "获取当前对话绑定的工作区与 Shell 会话 ID",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "read_file",
      "description": "读取当前工作区文本文件",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "工作区内相对路径"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "write_file",
      "description": "写入当前工作区文本文件；覆盖同名文件",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "工作区内相对路径"
          },
          "text": {
            "type": "string",
            "description": "完整文本"
          }
        },
        "required": [
          "path",
          "text"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "create_shell",
      "description": "在当前工作区创建命令会话",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "会话名称"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "shell_start",
      "description": "运行非交互式 Shell 命令，返回任务 ID；请随后轮询 shell_status 获取完成结果。以应用身份运行，可访问本应用文件与网络。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "shellId": {
            "type": "string",
            "description": "info 返回的 Shell ID"
          },
          "command": {
            "type": "string",
            "description": "用户确认的完整命令"
          }
        },
        "required": [
          "shellId",
          "command"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "shell_status",
      "description": "获取当前插件和角色在此工作区的 Shell 任务状态及输出",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "shell_start 返回的任务 ID"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "shell_stop",
      "description": "停止当前插件和角色的 Shell 任务",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "任务 ID"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    }
  ],
  "pages": [
    {
      "id": "main",
      "title": "工作区",
      "entry": "ui/index.html"
    },
    {
      "id": "changes",
      "title": "文件变更",
      "entry": "review/index.html",
      "context": "execution"
    }
  ],
  "hooks": [
    "beforeModel"
  ],
  "settings": [
    {
      "key": "projectRules",
      "label": "自动读取当前工作区项目规则",
      "kind": "boolean",
      "defaultValue": "true"
    }
  ]
}
