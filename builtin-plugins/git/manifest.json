{
  "id": "dev.solvit.git",
  "name": "Git 工作区",
  "description": "当前对话工作目录的文件预览、编辑、Git Changes、暂存、提交、历史与HTTPS远程拉取/推送审阅。",
  "version": "1.2.1",
  "apiVersion": 20,
  "permissions": [
    "workspace",
    "git",
    "network"
  ],
  "nativeServices": [
    "workspace.git"
  ],
  "dependencies": [],
  "tools": [
    {
      "name": "status",
      "description": "读取当前对话工作区真实Git状态；工作树和暂存区分别列出，不是历史执行快照。分页读取。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "diff",
      "description": "读取真实Git差异的完整分块。staged=false比较工作树与索引；true比较索引与HEAD。后续块必须携带上一块patchSha256，不可把第一块当完整差异。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "当前工作区相对文件路径"
          },
          "staged": {
            "type": "boolean"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "expectedPatchSha256": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "history",
      "description": "读取当前工作区真实Git提交历史。默认5条；结果过大请减少limit。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  ],
  "pages": [
    {
      "id": "main",
      "title": "Git 工作区",
      "entry": "ui/index.html"
    }
  ]
}
