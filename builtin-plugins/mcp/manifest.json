{
  "id": "dev.solvit.mcp",
  "name": "MCP 连接",
  "description": "JS/TS 多服务器 MCP：管理具名 HTTPS 和 Ubuntu 本地 stdio 连接；加密保存认证与环境，AI 按服务器发现及调用工具。",
  "version": "1.2.0",
  "apiVersion": 30,
  "permissions": [
    "network",
    "workspace",
    "shell"
  ],
  "dependencies": [],
  "settings": [
    {
      "key": "url",
      "label": "MCP HTTPS 地址",
      "kind": "url",
      "required": false,
      "pageManaged": true
    },
    {
      "key": "token",
      "label": "Bearer 令牌（可选）",
      "kind": "secret",
      "required": false,
      "pageManaged": true
    },
    {
      "key": "connections",
      "label": "MCP 服务器",
      "kind": "secret",
      "pageManaged": true
    }
  ],
  "tools": [
    {
      "name": "mcp_servers",
      "description": "列出已配置 MCP 服务器名称、传输、启停与当前聊天会话状态。不会输出地址、命令参数、环境变量或认证。多个服务器时后续工具必须指定 server。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "mcp_connect",
      "description": "连接已保存的具名 MCP 服务器并发现工具。本地 stdio 需要当前聊天已绑定工作区并安装 Ubuntu 及对应软件，不能传入临时命令。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "mcp_servers 返回的具名服务器；多个启用服务器时必须指定。"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "mcp_tools",
      "description": "列出 MCP 服务器工具及输入格式。调用远程工具前先查询此列表。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "server": {
            "type": "string",
            "description": "mcp_servers 返回的具名服务器；多个启用服务器时必须指定。"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "mcp_call",
      "description": "执行已发现的 MCP 远程工具。name 与 arguments 必须按 mcp_tools 的描述填写；可能改变远程数据，须遵从用户意图。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "arguments": {
            "type": "object"
          },
          "server": {
            "type": "string",
            "description": "mcp_servers 返回的具名服务器；多个启用服务器时必须指定。"
          }
        },
        "required": [
          "name",
          "arguments"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "mcp_disconnect",
      "description": "关闭指定服务器会话；不传 server 时关闭 HTTPS 与当前聊天作用域的本地会话。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "mcp_servers 返回的具名服务器；多个启用服务器时必须指定。"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  ],
  "pages": [
    {
      "id": "main",
      "title": "MCP 服务器",
      "entry": "ui/index.html"
    }
  ],
  "nativeServices": [
    "environment.linux",
    "process.stdio"
  ]
}
